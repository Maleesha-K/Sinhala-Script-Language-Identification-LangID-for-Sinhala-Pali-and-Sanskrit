# Settings for docker-compose.yml. Copy to .env and fill in.

# Public domain whose DNS A record points at this server. Caddy fetches the
# TLS certificate for it automatically (ports 80 and 443 must be open).
DOMAIN=langid.example.com

# Generate with: openssl rand -hex 32
SECRET_KEY=
POSTGRES_PASSWORD=
MINIO_ROOT_PASSWORD=
# (MinIO requires at least 8 characters)

POSTGRES_USER=langid
POSTGRES_DB=langid_db
MINIO_ROOT_USER=langid

# Created on first start if it does not exist yet.
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=

# PayHere: leave unset to use the sandbox merchant.
# PAYHERE_MERCHANT_ID=
# PAYHERE_MERCHANT_SECRET=
# PAYHERE_MODE=live

# Model directories on this server (defaults: the repo layout). See README.md.
# BASELINE_MODELS_DIR=./models
# FINETUNED_MODELS_DIR=../data_pipeline/models/03_global_rehearsal_sota

# Process counts. Each Celery process holds up to ~5 GB of classification models.
API_WORKERS=2
CELERY_CONCURRENCY=1
# Parallel Tesseract OCR runs (light: no models loaded).
OCR_CONCURRENCY=1
