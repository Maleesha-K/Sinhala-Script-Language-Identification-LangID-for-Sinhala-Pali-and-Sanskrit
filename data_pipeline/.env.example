# Copy to .env and fill in. `run_pipeline.py` checks these before running.

# Required. Read token from https://huggingface.co/settings/tokens
# The account must have accepted the terms of the gated datasets:
#   https://huggingface.co/datasets/openlanguagedata/flores_plus
#   https://huggingface.co/datasets/commoncrawl/CommonLID
#   https://huggingface.co/datasets/laurievb/OpenLID-v2
HF_TOKEN=your_hf_access_token_here

# Optional. Where Hugging Face caches downloads (defaults to ~/.cache/huggingface).
# HF_HOME=

# Optional. auto | cpu | cuda
PIPELINE_DEVICE=auto

# Optional. 1 = skip models that need a CUDA GPU (XLM-R, ConLID training)
# instead of failing preflight. Skipped models are recorded in run metadata.
SKIP_GPU_MODELS=0

# Optional. Where this project's own artefacts live on Hugging Face (the target
# dataset; later the fine-tuned models). Change these to use a fork/mirror.
HF_ORG=script-langid
HF_TARGET_DATASET=sinhala-script-lid
# Maintainers only: 1 = repos created by the publish scripts are private.
HF_PUBLISH_PRIVATE=1
